{
  "name": "agent-hooks-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "node ./scripts/agent-check.mjs",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run test:behavior && npm run format && npm run typecheck && npm run build",
    "verify:implementation": "node ./scripts/verify-implementation.mjs",
    "verify:submission": "node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json && node ./scripts/check-submission.mjs",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "test:behavior": "node --test ./tests/approval.test.mjs",
    "test:challenge": "node --test ./tests/hook-validation.test.mjs",
    "check:changes": "npm run typecheck && npm run test:behavior",
    "hooks:snapshot": "node ./scripts/source-snapshot.mjs",
    "evidence:seal": "node ./scripts/check-submission.mjs seal",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs",
    "evidence:verify": "npm run agent:check && npm run verify:implementation && node ./scripts/check-submission.mjs content"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
