+package dev.agentic.exercise.workflow;
+
+import org.springframework.stereotype.Component;
+
+/**
+ * Applies the validation rules for a proposed workflow decision.
+ *
+ * <p>This policy deliberately has no repository dependency: looking up the current workflow item,
+ * constructing its accepted replacement, and persisting that replacement remain orchestration
+ * responsibilities of {@link WorkflowService}.
+ */
+@Component
+public class DecisionPolicy {
+  public void validate(WorkflowDecision decision) {
+    if ("Ready".equals(decision.status()) && decision.evidenceNote().length() < 12) {
+      throw new InvalidWorkflowDecisionException("Ready decisions require a longer evidence note");
+    }
+  }
+}
