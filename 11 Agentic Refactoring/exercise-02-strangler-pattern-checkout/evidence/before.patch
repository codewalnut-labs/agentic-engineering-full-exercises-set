@@ -0,0 +1,77 @@
+import assert from "node:assert/strict";
+import { routeCheckout } from "./checkoutRouter.mjs";
+
+const cardRequest = {
+  orderId: "ord-router",
+  paymentType: "card",
+  subtotalCents: 1001,
+  taxRateBps: 825,
+  paymentToken: "tok-router",
+};
+
+function paidResult(request) {
+  return {
+    orderId: request.orderId,
+    status: "paid",
+    totalCents: request.subtotalCents + Math.round(request.subtotalCents * request.taxRateBps / 10000),
+    errorCode: null,
+  };
+}
+
+function checkoutFakes(card = async (request) => paidResult(request)) {
+  const calls = { legacy: [], card: [] };
+  return {
+    calls,
+    implementations: {
+      legacy: async (request) => {
+        calls.legacy.push(structuredClone(request));
+        return paidResult(request);
+      },
+      card: async (request) => {
+        calls.card.push(structuredClone(request));
+        return card(request);
+      },
+      cardSliceEnabled: true,
+    },
+  };
+}
+
+const enabled = checkoutFakes();
+assert.deepEqual(await routeCheckout(structuredClone(cardRequest), enabled.implementations), paidResult(cardRequest));
+assert.deepEqual(enabled.calls, { legacy: [], card: [cardRequest] }, "enabled card checkout must use only the new slice");
+
+for (const paymentType of ["gift-card", "invoice", "unknown"]) {
+  const scenario = checkoutFakes();
+  const request = { ...cardRequest, paymentType };
+  await routeCheckout(structuredClone(request), scenario.implementations);
+  assert.deepEqual(scenario.calls, { legacy: [request], card: [] }, `${paymentType} must stay on legacy checkout`);
+}
+
+const disabled = checkoutFakes();
+disabled.implementations.cardSliceEnabled = false;
+await routeCheckout(structuredClone(cardRequest), disabled.implementations);
+assert.deepEqual(disabled.calls, { legacy: [cardRequest], card: [] }, "flag off must provide immediate legacy rollback");
+
+const beforeAuthorization = checkoutFakes(async () => {
+  throw { authorizationCreated: false };
+});
+assert.deepEqual(
+  await routeCheckout(structuredClone(cardRequest), beforeAuthorization.implementations),
+  paidResult(cardRequest),
+);
+assert.deepEqual(beforeAuthorization.calls, { legacy: [cardRequest], card: [cardRequest] });
+
+const unknownResult = { ...paidResult(cardRequest), status: "failed", errorCode: "PAYMENT_STATE_UNKNOWN" };
+for (const failure of [
+  { authorizationCreated: true, result: unknownResult },
+  { result: unknownResult },
+  new Error("authorization outcome unknown"),
+]) {
+  const ambiguous = checkoutFakes(async () => {
+    throw failure;
+  });
+  assert.deepEqual(await routeCheckout(structuredClone(cardRequest), ambiguous.implementations), unknownResult);
+  assert.deepEqual(ambiguous.calls, { legacy: [], card: [cardRequest] }, "ambiguous authorization must not duplicate payment");
+}
+
+console.log("PASS public checkout router characterization");
