-/** Seeded router: all payment types still flow through the legacy implementation. */
+function calculateTotalCents(request) {
+  return request.subtotalCents + Math.round(request.subtotalCents * request.taxRateBps / 10000);
+}
+
+function paymentStateUnknown(request) {
+  return {
+    orderId: request.orderId,
+    status: "failed",
+    totalCents: calculateTotalCents(request),
+    errorCode: "PAYMENT_STATE_UNKNOWN",
+  };
+}
+
+function isPublicResult(result, request) {
+  if (result === null || typeof result !== "object" || Array.isArray(result)) return false;
+
+  const fields = Object.keys(result).sort();
+  const expectedFields = ["errorCode", "orderId", "status", "totalCents"];
+  return fields.length === expectedFields.length
+    && fields.every((field, index) => field === expectedFields[index])
+    && result.orderId === request.orderId
+    && (result.status === "paid" || result.status === "failed")
+    && result.totalCents === calculateTotalCents(request)
+    && (result.errorCode === null || typeof result.errorCode === "string");
+}
+
+function isExplicitlyBeforeAuthorization(error) {
+  return error !== null
+    && typeof error === "object"
+    && !Array.isArray(error)
+    && Object.prototype.hasOwnProperty.call(error, "authorizationCreated")
+    && error.authorizationCreated === false;
+}
+
 export async function routeCheckout(request, implementations) {
-  return implementations.legacy(request);
+  if (request.paymentType !== "card" || !implementations.cardSliceEnabled) {
+    return implementations.legacy(request);
+  }
+
+  try {
+    return await implementations.card(request);
+  } catch (error) {
+    if (isExplicitlyBeforeAuthorization(error)) {
+      return implementations.legacy(request);
+    }
+
+    return isPublicResult(error?.result, request)
+      ? error.result
+      : paymentStateUnknown(request);
+  }
 }
diff --git a/11 Agentic Refactoring/exercise-02-strangler-pattern-checkout/checkout-strangler-app/src/checkout/checkoutRouter.test.mjs b/11 Agentic Refactoring/exercise-02-strangler-pattern-checkout/checkout-strangler-app/src/checkout/checkoutRouter.test.mjs
