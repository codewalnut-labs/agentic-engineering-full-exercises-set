@@ -0,0 +1,42 @@
+function calculateTotalCents(request) {
+  const taxCents = Math.round(request.subtotalCents * request.taxRateBps / 10000);
+  return request.subtotalCents + taxCents;
+}
+
+function paidResult(request, totalCents) {
+  return {
+    orderId: request.orderId,
+    status: "paid",
+    totalCents,
+    errorCode: null,
+  };
+}
+
+function declinedResult(request, totalCents) {
+  return {
+    orderId: request.orderId,
+    status: "failed",
+    totalCents,
+    errorCode: "PAYMENT_DECLINED",
+  };
+}
+
+/**
+ * Creates the card-only checkout slice. Authorization failures intentionally
+ * remain unhandled here so the router can decide whether retrying through the
+ * legacy implementation is safe.
+ */
+export function createCardCheckout({ authorize }) {
+  return async function cardCheckout(request) {
+    const totalCents = calculateTotalCents(request);
+    const authorization = await authorize({
+      orderId: request.orderId,
+      amountCents: totalCents,
+      paymentToken: request.paymentToken,
+    });
+
+    return authorization.approved
+      ? paidResult(request, totalCents)
+      : declinedResult(request, totalCents);
+  };
+}
