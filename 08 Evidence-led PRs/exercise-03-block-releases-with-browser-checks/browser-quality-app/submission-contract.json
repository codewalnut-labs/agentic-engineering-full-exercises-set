{
  "name": "Block a Release That Fails Browser Quality Checks",
  "root": "..",
  "requiredFiles": [
    {
      "path": "evidence/before.md",
      "minCharacters": 220,
      "includeAll": [
        "## Conditions",
        "## Findings",
        "## Proof",
        "Starting commit:"
      ]
    },
    {
      "path": "evidence/after.md",
      "minCharacters": 250,
      "includeAll": [
        "## Conditions",
        "## Findings",
        "## Proof",
        "Implementation commit:"
      ]
    },
    {
      "path": "evidence/comparison.md",
      "minCharacters": 250,
      "includeAll": [
        "## Changes",
        "## Verified",
        "## Remaining questions"
      ]
    },
    {
      "path": "evidence/pr-summary.md",
      "minCharacters": 600,
      "includeAll": [
        "## Change",
        "## Checks",
        "## Decision",
        "## Risk and rollback",
        "Source SHA:",
        "Decision: READY FOR REVIEW",
        "Reproduce"
      ]
    },
    {
      "path": "evidence/source-audit.json",
      "validJson": true,
      "minCharacters": 200,
      "includeAll": [
        "claims",
        "topic",
        "artifact",
        "sources",
        "excerpt"
      ]
    },
    {
      "path": "evidence/skill-use.md",
      "minCharacters": 150,
      "includeAll": [
        "## verification-before-completion",
        "Source:",
        "Invocation:",
        "Proof:"
      ]
    },
    {
      "path": "evidence/skill-session.txt",
      "minCharacters": 100
    },
    {
      "path": "evidence/manifest.json",
      "validJson": true,
      "minCharacters": 100,
      "includeAll": [
        "algorithm",
        "sourceSha",
        "files"
      ]
    },
    {
      "path": "evidence/commands/checks.txt",
      "minCharacters": 200,
      "includeAll": [
        "Command: npm run quality:verify",
        "Repository commit:",
        "Started at:",
        "Finished at:"
      ]
    },
    {
      "path": "evidence/commands/verify.txt",
      "minCharacters": 200,
      "includeAll": [
        "Command: npm run evidence:verify",
        "Repository commit:",
        "Started at:",
        "Finished at:",
        "exit code: 0"
      ]
    },
    {
      "path": "evidence/quality-report.md",
      "minCharacters": 1400,
      "includeAll": [
        "Source SHA",
        "Release decision: PASSED",
        "Before and after",
        "Comparable environment",
        "Raw artifact trace",
        "Failure-path proof",
        "Residual risk",
        "reference data"
      ]
    },
    {
      "path": "browser-quality-app/lighthouserc.json",
      "validJson": true,
      "minCharacters": 650,
      "includeAll": [
        "staticDistDir",
        "http://localhost/",
        "numberOfRuns",
        "onlyCategories",
        "formFactor",
        "mobile",
        "screenEmulation",
        "deviceScaleFactor",
        "throttlingMethod",
        "simulate",
        "categories:performance",
        "categories:accessibility",
        "largest-contentful-paint",
        "pessimistic"
      ]
    },
    {
      "path": "browser-quality-app/scripts/quality-gate.mjs",
      "minCharacters": 1200,
      "includeAll": [
        "--lighthouse-dir",
        "--axe",
        "--contract",
        "--sha",
        "--output",
        "worstCase",
        "releaseDecision",
        "process.exitCode"
      ]
    },
    {
      "path": "evidence/raw/lighthouse/run-1.json",
      "validJson": true,
      "minCharacters": 50000,
      "includeAll": [
        "lighthouseVersion",
        "fetchTime",
        "finalUrl",
        "categories",
        "performance",
        "accessibility",
        "largest-contentful-paint",
        "environment"
      ]
    },
    {
      "path": "evidence/raw/lighthouse/run-2.json",
      "validJson": true,
      "minCharacters": 50000,
      "includeAll": [
        "lighthouseVersion",
        "fetchTime",
        "finalUrl",
        "categories",
        "performance",
        "accessibility",
        "largest-contentful-paint",
        "environment"
      ]
    },
    {
      "path": "evidence/raw/lighthouse/run-3.json",
      "validJson": true,
      "minCharacters": 50000,
      "includeAll": [
        "lighthouseVersion",
        "fetchTime",
        "finalUrl",
        "categories",
        "performance",
        "accessibility",
        "largest-contentful-paint",
        "environment"
      ]
    },
    {
      "path": "evidence/raw/axe.json",
      "validJson": true,
      "minCharacters": 250,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "testedUrl",
        "generatedAt",
        "browser",
        "captureEnvironment",
        "deviceScaleFactor",
        "violations"
      ]
    },
    {
      "path": "evidence/capture-manifest.json",
      "validJson": true,
      "minCharacters": 900,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "configSha256",
        "productionBuildSha256",
        "captureSession",
        "browser",
        "captureEnvironment",
        "deviceScaleFactor",
        "lighthouseReports",
        "axeReport",
        "sha256"
      ]
    },
    {
      "path": "evidence/capture-complete.json",
      "validJson": true,
      "minCharacters": 180,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "captureSession",
        "manifestSha256",
        "completedAt"
      ]
    },
    {
      "path": "evidence/quality-summary.json",
      "validJson": true,
      "minCharacters": 2500,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "pessimistic",
        "thresholds",
        "lighthouseRuns",
        "sha256",
        "worstCase",
        "axeViolations",
        "releaseDecision",
        "passed"
      ]
    }
  ],
  "requiredDirectories": [
    "evidence",
    "evidence/raw",
    "evidence/raw/lighthouse",
    "evidence/commands"
  ],
  "evidenceMode": "observation"
}
