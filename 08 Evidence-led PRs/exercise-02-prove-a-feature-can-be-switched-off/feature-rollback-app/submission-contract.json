{
  "name": "Prove a Feature Can Be Switched Off Safely",
  "root": "..",
  "requiredFiles": [
    {
      "path": "evidence/before.md",
      "minCharacters": 220,
      "includeAll": [
        "## Conditions",
        "## Findings",
        "## Proof",
        "Starting commit:"
      ]
    },
    {
      "path": "evidence/after.md",
      "minCharacters": 250,
      "includeAll": [
        "## Conditions",
        "## Findings",
        "## Proof",
        "Implementation commit:"
      ]
    },
    {
      "path": "evidence/comparison.md",
      "minCharacters": 250,
      "includeAll": [
        "## Changes",
        "## Verified",
        "## Remaining questions"
      ]
    },
    {
      "path": "evidence/pr-summary.md",
      "minCharacters": 600,
      "includeAll": [
        "## Change",
        "## Checks",
        "## Decision",
        "## Risk and rollback",
        "Source SHA:",
        "Decision: READY FOR REVIEW",
        "Reproduce"
      ]
    },
    {
      "path": "evidence/source-audit.json",
      "validJson": true,
      "minCharacters": 200,
      "includeAll": [
        "claims",
        "topic",
        "artifact",
        "sources",
        "excerpt"
      ]
    },
    {
      "path": "evidence/skill-use.md",
      "minCharacters": 150,
      "includeAll": [
        "## verification-before-completion",
        "Source:",
        "Invocation:",
        "Proof:"
      ]
    },
    {
      "path": "evidence/skill-session.txt",
      "minCharacters": 100
    },
    {
      "path": "evidence/manifest.json",
      "validJson": true,
      "minCharacters": 100,
      "includeAll": [
        "algorithm",
        "sourceSha",
        "files"
      ]
    },
    {
      "path": "evidence/commands/checks.txt",
      "minCharacters": 200,
      "includeAll": [
        "Command: npm run rollout:verify",
        "Repository commit:",
        "Started at:",
        "Finished at:"
      ]
    },
    {
      "path": "evidence/commands/verify.txt",
      "minCharacters": 200,
      "includeAll": [
        "Command: npm run evidence:verify",
        "Repository commit:",
        "Started at:",
        "Finished at:",
        "exit code: 0"
      ]
    },
    {
      "path": "feature-rollback-app/scripts/rollback-invoice-preview.mjs",
      "minCharacters": 1300,
      "includeAll": [
        "--config",
        "--actor",
        "--reason",
        "--timestamp",
        "--expected-revision",
        "invoice-preview-v2",
        "previousRevision",
        "ROLLBACK_TEST_FAIL_BEFORE_RENAME",
        "writeFile",
        "rename"
      ]
    },
    {
      "path": "evidence/enabled.json",
      "validJson": true,
      "minCharacters": 700,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "enabled",
        "invoice-preview-v2",
        "defaultValue",
        "targetingKey",
        "accountId",
        "apiCalls",
        "invoice_preview_viewed",
        "passed"
      ]
    },
    {
      "path": "evidence/disabled.json",
      "validJson": true,
      "minCharacters": 500,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "disabled",
        "flag-disabled",
        "defaultValue",
        "apiCalls",
        "telemetry",
        "passed"
      ]
    },
    {
      "path": "evidence/provider-error.json",
      "validJson": true,
      "minCharacters": 500,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "provider-error",
        "flag-evaluation-error",
        "defaultValue",
        "apiCalls",
        "telemetry",
        "passed"
      ]
    },
    {
      "path": "evidence/rollback-drill.json",
      "validJson": true,
      "minCharacters": 2000,
      "includeAll": [
        "schemaVersion",
        "sourceSha",
        "startTime",
        "endTime",
        "elapsedMs",
        "configBeforeSha256",
        "configAfterSha256",
        "lastRollback",
        "previousRevision",
        "behaviorBefore",
        "behaviorAfter",
        "atomicProtocol",
        "interruptionCheck",
        "concurrencyCheck",
        "exitCodes",
        "remainingCleanup",
        "passed"
      ]
    },
    {
      "path": "evidence/rollback-drill.md",
      "minCharacters": 850,
      "includeAll": [
        "Source SHA",
        "Command",
        "Start time",
        "End time",
        "Elapsed",
        "Before rollback",
        "After rollback",
        "Interrupted update: PASS",
        "Concurrent rollback: PASS",
        "Target allowlist: empty",
        "API calls: 0",
        "Telemetry events: 0",
        "Result: PASS",
        "Remaining cleanup"
      ]
    }
  ],
  "requiredDirectories": [
    "evidence",
    "evidence/commands"
  ],
  "evidenceMode": "observation"
}
