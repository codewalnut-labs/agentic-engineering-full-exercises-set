{
  "name": "feature-rollback-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "node ./scripts/test-rollout-verifier.mjs && node ./scripts/agent-check.mjs && npm run test:challenge",
    "test:rollout": "node ./scripts/run-rollout-tests.mjs",
    "rollout:capture": "node ./scripts/capture-rollout-evidence.mjs",
    "rollback:drill": "node ./scripts/run-rollback-drill.mjs",
    "rollout:verify": "node ./scripts/verify-rollout-submission.mjs",
    "test:submission": "npm run test:rollout && npm run rollout:verify && node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run test:rollout && npm run rollout:verify",
    "verify:submission": "node ./scripts/verify-review-evidence.mjs && npm run test:submission",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "test:challenge": "node --test ../../scripts/pr-review-evidence.test.mjs",
    "proof:capture": "node ../../scripts/capture-proof.mjs",
    "evidence:seal": "node ./scripts/verify-review-evidence.mjs seal",
    "evidence:check": "node ./scripts/verify-review-evidence.mjs content",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs",
    "evidence:verify": "npm run agent:check && npm run verify:implementation && npm run evidence:check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
