{
  "name": "rtk-investigation-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "node --test ../../scripts/economics-evidence.test.mjs && node ./scripts/check-starter.mjs",
    "lint": "node ./scripts/check-starter.mjs",
    "format": "node ./scripts/format-check.mjs",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "baseline:observe": "node ./scripts/check-starter.mjs",
    "experiment:run": "node ../../scripts/run-experiment.mjs",
    "experiment:score": "node ../../scripts/score-experiment.mjs",
    "verify:implementation": "node ../../scripts/check-implementation.mjs",
    "economics:check": "npm run verify:implementation && node ../../scripts/score-experiment.mjs --verify",
    "verify:submission": "node ../../../scripts/verify-submission-contract.mjs ./submission-contract.json && node ./scripts/verify-economics-evidence.mjs",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "proof:capture": "node ../../scripts/capture-economics-check.mjs",
    "evidence:seal": "node ./scripts/verify-economics-evidence.mjs seal",
    "evidence:verify": "npm run agent:check && npm run economics:check && node ./scripts/verify-economics-evidence.mjs content",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
