@@ -2,18 +2,160 @@ import type {
   AcceptInvitationInput,
   CreateInvitationInput,
   InvitationActionResult,
+  InvitationRole,
   InvitationState,
-  RevokeInvitationInput
+  RevokeInvitationInput,
+  TeamInvitation,
+  TeamMember
 } from "../types";
 
-export function createInvitation(_state: InvitationState, _input: CreateInvitationInput): InvitationActionResult {
-  throw new Error("Invitation lifecycle is not implemented");
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const INVITE_TARGET_ROLES: InvitationRole[] = ["member", "guest"];
+
+function normalizeEmail(email: string) {
+  return email.trim().toLowerCase();
+}
+
+function isValidEmail(email: string) {
+  return EMAIL_PATTERN.test(email);
+}
+
+function isExpired(expiresAt: string, now: string) {
+  return expiresAt <= now;
+}
+
+function rejected(state: InvitationState, code: InvitationActionResult["code"]): InvitationActionResult {
+  return { ok: false, state, code };
+}
+
+function canActOnInvitations(actorId: string, state: InvitationState) {
+  const actor = state.members.find((member) => member.id === actorId);
+  return Boolean(actor && actor.status === "active" && state.policy.inviteRoles.includes(actor.role));
+}
+
+export function createInvitation(state: InvitationState, input: CreateInvitationInput): InvitationActionResult {
+  if (!canActOnInvitations(input.actorId, state)) {
+    return rejected(state, "UNAUTHORIZED");
+  }
+
+  if (!INVITE_TARGET_ROLES.includes(input.role)) {
+    return rejected(state, "INVALID_ROLE");
+  }
+
+  if (input.role === "guest" && !state.policy.allowGuestInvites) {
+    return rejected(state, "GUEST_DISABLED");
+  }
+
+  const email = normalizeEmail(input.email);
+  if (!isValidEmail(email)) {
+    return rejected(state, "INVALID_EMAIL");
+  }
+
+  const memberExists = state.members.some((member) => normalizeEmail(member.email) === email);
+  if (memberExists) {
+    return rejected(state, "MEMBER_EXISTS");
+  }
+
+  const hasPendingInvitation = state.invitations.some(
+    (invitation) =>
+      normalizeEmail(invitation.email) === email &&
+      invitation.status === "pending" &&
+      !isExpired(invitation.expiresAt, input.now)
+  );
+  if (hasPendingInvitation) {
+    return rejected(state, "INVITATION_PENDING");
+  }
+
+  const duplicateId = state.invitations.some((invitation) => invitation.id === input.invitationId);
+  if (duplicateId) {
+    return rejected(state, "DUPLICATE_INVITATION_ID");
+  }
+
+  const expiresAt = new Date(
+    new Date(input.now).getTime() + state.policy.defaultInviteExpiryDays * 24 * 60 * 60 * 1000
+  ).toISOString();
+
+  const invitation: TeamInvitation = {
+    id: input.invitationId,
+    email,
+    role: input.role,
+    invitedBy: input.actorId,
+    createdAt: input.now,
+    expiresAt,
+    status: "pending"
+  };
+
+  const nextState: InvitationState = {
+    ...state,
+    invitations: [...state.invitations, invitation]
+  };
+
+  return { ok: true, state: nextState, invitation };
 }
 
-export function acceptInvitation(_state: InvitationState, _input: AcceptInvitationInput): InvitationActionResult {
-  throw new Error("Invitation lifecycle is not implemented");
+export function acceptInvitation(state: InvitationState, input: AcceptInvitationInput): InvitationActionResult {
+  const invitation = state.invitations.find((item) => item.id === input.invitationId);
+  if (!invitation) {
+    return rejected(state, "INVITATION_NOT_FOUND");
+  }
+
+  if (invitation.status !== "pending") {
+    return rejected(state, "INVITATION_FINAL");
+  }
+
+  if (isExpired(invitation.expiresAt, input.now)) {
+    return rejected(state, "INVITATION_EXPIRED");
+  }
+
+  const duplicateMember = state.members.some((member) => member.id === input.memberId);
+  if (duplicateMember) {
+    return rejected(state, "DUPLICATE_MEMBER_ID");
+  }
+
+  const newMember: TeamMember = {
+    id: input.memberId,
+    name: invitation.email,
+    email: invitation.email,
+    role: invitation.role,
+    status: "active",
+    lastActiveDays: 0
+  };
+
+  const acceptedInvitation: TeamInvitation = { ...invitation, status: "accepted" };
+
+  const nextState: InvitationState = {
+    ...state,
+    members: [...state.members, newMember],
+    invitations: state.invitations.map((item) => (item.id === invitation.id ? acceptedInvitation : item))
+  };
+
+  return { ok: true, state: nextState, invitation: acceptedInvitation };
 }
 
-export function revokeInvitation(_state: InvitationState, _input: RevokeInvitationInput): InvitationActionResult {
-  throw new Error("Invitation lifecycle is not implemented");
+export function revokeInvitation(state: InvitationState, input: RevokeInvitationInput): InvitationActionResult {
+  if (!canActOnInvitations(input.actorId, state)) {
+    return rejected(state, "UNAUTHORIZED");
+  }
+
+  const invitation = state.invitations.find((item) => item.id === input.invitationId);
+  if (!invitation) {
+    return rejected(state, "INVITATION_NOT_FOUND");
+  }
+
+  if (invitation.status !== "pending") {
+    return rejected(state, "INVITATION_FINAL");
+  }
+
+  if (isExpired(invitation.expiresAt, input.now)) {
+    return rejected(state, "INVITATION_EXPIRED");
+  }
+
+  const revokedInvitation: TeamInvitation = { ...invitation, status: "revoked" };
+
+  const nextState: InvitationState = {
+    ...state,
+    invitations: state.invitations.map((item) => (item.id === invitation.id ? revokedInvitation : item))
+  };
+
+  return { ok: true, state: nextState, invitation: revokedInvitation };
 }
