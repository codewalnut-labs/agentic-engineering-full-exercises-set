-/** Seeded analyzer: it counts every read and failed command as waste. */
+const KNOWN_EVENT_TYPES = new Set(["read", "context", "command", "diagnosis", "write", "claim"]);
+
+function validateEvents(events) {
+  if (!Array.isArray(events)) throw new TypeError("events must be an array");
+
+  let previousSequence = -Infinity;
+  events.forEach((event, index) => {
+    if (!event || typeof event !== "object" || Array.isArray(event)) {
+      throw new TypeError(`event ${index + 1} must be an object`);
+    }
+    if (!Number.isInteger(event.sequence) || event.sequence <= previousSequence) {
+      throw new TypeError(`event ${index + 1} sequence must be an increasing integer`);
+    }
+    previousSequence = event.sequence;
+
+    if (typeof event.type !== "string" || !KNOWN_EVENT_TYPES.has(event.type)) {
+      throw new TypeError(`event ${event.sequence} has an invalid type`);
+    }
+    if (typeof event.target !== "string" || event.target.length === 0) {
+      throw new TypeError(`event ${event.sequence} needs a target`);
+    }
+    if (!Number.isInteger(event.workspaceRevision) || event.workspaceRevision < 0) {
+      throw new TypeError(`event ${event.sequence} needs a valid workspaceRevision`);
+    }
+    if (typeof event.result !== "string" || event.result.length === 0) {
+      throw new TypeError(`event ${event.sequence} needs a result`);
+    }
+    if (event.type === "read" && (typeof event.contentVersion !== "string" || event.contentVersion.length === 0)) {
+      throw new TypeError(`read event ${event.sequence} needs a contentVersion`);
+    }
+    if (event.type === "context" && (!Number.isFinite(event.bytes) || event.bytes < 0)) {
+      throw new TypeError(`context event ${event.sequence} needs non-negative bytes`);
+    }
+  });
+}
+
 export function analyzeSession(events) {
-  const duplicateReads = events.filter((event) => event.type === "read").length;
-  const unchangedFailureRetries = events.filter((event) => event.type === "command" && event.result === "failed").length;
+  validateEvents(events);
+
+  const seenReads = new Set();
+  const commandResults = new Map();
+  const finalWriteIndex = events.findLastIndex((event) => event.type === "write");
+  let currentRevision;
+  let duplicateReads = 0;
+  let unchangedFailureRetries = 0;
+  let oversizedContextLoads = 0;
+  let finalVerificationRuns = 0;
+
+  events.forEach((event, index) => {
+    if (currentRevision !== undefined && event.workspaceRevision !== currentRevision) commandResults.clear();
+    currentRevision = event.workspaceRevision;
+
+    if (event.type === "read") {
+      const readKey = JSON.stringify([event.target, event.contentVersion]);
+      if (seenReads.has(readKey)) duplicateReads += 1;
+      else seenReads.add(readKey);
+    }
+
+    if (event.type === "context" && event.bytes > 8_000) oversizedContextLoads += 1;
+
+    if (event.type === "diagnosis") commandResults.clear();
+    if (event.type === "command") {
+      if (commandResults.get(event.target) === "failed") unchangedFailureRetries += 1;
+      commandResults.set(event.target, event.result);
+
+      if (index > finalWriteIndex && event.phase === "final-verification" && event.result === "passed") {
+        finalVerificationRuns += 1;
+      }
+    }
+  });
+
   return {
     totalEvents: events.length,
     duplicateReads,
     unchangedFailureRetries,
-    oversizedContextLoads: 0,
-    preventableCalls: duplicateReads + unchangedFailureRetries,
-    finalVerificationRuns: 0,
-    correctnessPassed: false,
+    oversizedContextLoads,
+    preventableCalls: duplicateReads + unchangedFailureRetries + oversizedContextLoads,
+    finalVerificationRuns,
+    correctnessPassed: finalVerificationRuns > 0,
   };
 }
diff --git a/12 Agentic Retrospective/exercise-01-session-waste-retro-from-logs/session-waste-app/src/retro/analyzeSession.test.mjs b/12 Agentic Retrospective/exercise-01-session-waste-retro-from-logs/session-waste-app/src/retro/analyzeSession.test.mjs
