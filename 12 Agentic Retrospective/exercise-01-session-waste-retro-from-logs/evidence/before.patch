index 0000000000000000000000000000000000000000..cf9a040fce3e149d13363598f6621a6160fa3b0c
--- /dev/null
+++ b/12 Agentic Retrospective/exercise-01-session-waste-retro-from-logs/session-waste-app/src/retro/analyzeSession.test.mjs	
@@ -0,0 +1,63 @@
+import assert from "node:assert/strict";
+import { analyzeSession } from "./analyzeSession.mjs";
+import { evaluateCommandAttempt } from "./preflightPolicy.mjs";
+
+const event = (sequence, type, target, overrides = {}) => ({
+  sequence,
+  type,
+  target,
+  workspaceRevision: 1,
+  result: "ok",
+  ...overrides,
+});
+
+const usefulWork = [
+  event(1, "read", "policy.ts", { contentVersion: "v1" }),
+  event(2, "write", "policy.ts", { contentVersion: "v2", workspaceRevision: 2 }),
+  event(3, "read", "policy.ts", { contentVersion: "v2", workspaceRevision: 2 }),
+  event(4, "command", "npm test", { workspaceRevision: 2, result: "failed", phase: "focused-test" }),
+  event(5, "diagnosis", "incorrect fixture", { workspaceRevision: 2 }),
+  event(6, "command", "npm test", { workspaceRevision: 2, result: "passed", phase: "focused-test" }),
+  event(7, "command", "npm verify", { workspaceRevision: 2, result: "passed", phase: "final-verification" }),
+];
+
+assert.deepEqual(analyzeSession(usefulWork), {
+  totalEvents: 7,
+  duplicateReads: 0,
+  unchangedFailureRetries: 0,
+  oversizedContextLoads: 0,
+  preventableCalls: 0,
+  finalVerificationRuns: 1,
+  correctnessPassed: true,
+});
+
+const waste = [
+  event(1, "read", "policy.ts", { contentVersion: "v1" }),
+  event(2, "read", "policy.ts", { contentVersion: "v1" }),
+  event(3, "context", "architecture.md", { bytes: 8_001 }),
+  event(4, "command", "npm test", { result: "failed" }),
+  event(5, "command", "npm test", { result: "passed" }),
+];
+const wasteMetrics = analyzeSession(waste);
+assert.equal(wasteMetrics.duplicateReads, 1);
+assert.equal(wasteMetrics.unchangedFailureRetries, 1);
+assert.equal(wasteMetrics.oversizedContextLoads, 1);
+assert.equal(wasteMetrics.preventableCalls, 3);
+
+const failed = [event(1, "command", "npm test", { result: "failed" })];
+assert.deepEqual(evaluateCommandAttempt({ command: "npm test", workspaceRevision: 1, events: failed }), {
+  allowed: false,
+  reason: "DIAGNOSIS_OR_CHANGE_REQUIRED",
+});
+assert.equal(evaluateCommandAttempt({ command: "npm lint", workspaceRevision: 1, events: failed }).allowed, true);
+assert.equal(evaluateCommandAttempt({ command: "npm test", workspaceRevision: 2, events: failed }).allowed, true);
+assert.equal(evaluateCommandAttempt({
+  command: "npm test",
+  workspaceRevision: 1,
+  events: [...failed, event(2, "diagnosis", "test setup is stale")],
+}).allowed, true);
+
+assert.throws(() => analyzeSession([event(1, "read", "policy.ts", { contentVersion: "v1" }), event(1, "claim", "done")]), /sequence/i);
+assert.throws(() => analyzeSession([event(1, "context", "architecture.md")]), /bytes/i);
+
+console.log("PASS participant analyzer and retry-preflight tests");
diff --git a/12 Agentic Retrospective/exercise-01-session-waste-retro-from-logs/session-waste-app/src/retro/preflightPolicy.mjs b/12 Agentic Retrospective/exercise-01-session-waste-retro-from-logs/session-waste-app/src/retro/preflightPolicy.mjs
