{
  "name": "checkout-e2e-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "setup:browser": "playwright install chromium",
    "setup:check": "node ./scripts/check-playwright-setup.mjs && npm run test:smoke",
    "test:e2e": "node ./scripts/run-browser.mjs final",
    "test:e2e:reproduce": "node ./scripts/run-browser.mjs baseline",
    "test:smoke": "node ./scripts/run-browser.mjs smoke",
    "test:checkout": "node ./scripts/verify-checkout-submission.mjs",
    "test:submission": "npm run test:checkout",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "test": "node ./scripts/agent-check.mjs",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "verify:implementation": "npm run test:e2e",
    "verify:submission": "npm run test:checkout",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "evidence:capture": "node ../../scripts/capture-evidence.mjs",
    "test:challenge": "node --test ../../scripts/test-evidence.test.mjs",
    "test:repeat": "node ./scripts/run-browser.mjs final"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
