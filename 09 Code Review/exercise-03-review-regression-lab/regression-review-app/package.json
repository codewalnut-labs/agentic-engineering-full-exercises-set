{
    "name": "regression-review-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "tsc -b --pretty false",
        "test": "node ./scripts/agent-check.mjs && node ./scripts/run-review-evals.mjs && node ./scripts/verify-review-eval.mjs",
        "eval:before": "promptfoo eval -c promptfoo.before.yaml --no-cache --no-progress-bar --output evidence/promptfoo-before.json",
        "eval:after": "promptfoo eval -c promptfoo.after.yaml --no-cache --no-progress-bar --output evidence/promptfoo-after.json",
        "eval:review": "node ./scripts/run-review-evals.mjs",
        "lint": "node ./scripts/lint-check.mjs",
        "format": "node ./scripts/format-check.mjs",
        "agent:check": "npm run lint && npm run test && npm run format && npm run typecheck && npm run build"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.0.4",
        "promptfoo": "0.121.19",
        "typescript": "^5.9.3",
        "vite": "^7.1.12"
    }
}
